  <item>
    <title>Before reaching the shore</title>
    <link>https://river.yoso.one/#t0</link>
    <guid isPermaLink="false">on-river:river-t0</guid>
    <pubDate>Tue, 20 Oct 2026 13:24:50 +0900</pubDate>
    <category>River</category>
    <description>&lt;p&gt;Before reaching the shore,
in the quiet sea of abstraction;
Seize the mind.&lt;/p&gt;&lt;p&gt;From River.&lt;/p&gt;</description>
  </item>
  <item>
    <title>To feel with opened eyes</title>
    <link>https://river.yoso.one/#t1</link>
    <guid isPermaLink="false">on-river:river-t1</guid>
    <pubDate>Tue, 20 Oct 2026 13:24:49 +0900</pubDate>
    <category>River</category>
    <description>&lt;p&gt;To feel with opened eyes,
to listen with the heart,
to speak with truth.&lt;/p&gt;&lt;p&gt;From River.&lt;/p&gt;</description>
  </item>
  <item>
    <title>Wind’s Natural Soul</title>
    <link>https://river.yoso.one/#t2</link>
    <guid isPermaLink="false">on-river:river-t2</guid>
    <pubDate>Tue, 20 Oct 2026 13:24:48 +0900</pubDate>
    <category>River</category>
    <description>&lt;p&gt;Wind’s Natural Soul…
Leading me to the unknown…
Transcendental Flow.&lt;/p&gt;&lt;p&gt;From River.&lt;/p&gt;</description>
  </item>
  <item>
    <title>Breathe in</title>
    <link>https://river.yoso.one/#t3</link>
    <guid isPermaLink="false">on-river:river-t3</guid>
    <pubDate>Tue, 20 Oct 2026 13:24:47 +0900</pubDate>
    <category>River</category>
    <description>&lt;p&gt;Breathe in…
Breathe out…
The energy that connects all forms…
Infinite chains of chemical reactions…
Trillions of cells living within…
What am I?&lt;/p&gt;&lt;p&gt;From River.&lt;/p&gt;</description>
  </item>
