  <item>
    <title>Mind the gap</title>
    <link>https://river.yoso.one/#t111</link>
    <guid isPermaLink="false">on-river:river-t111</guid>
    <pubDate>Tue, 27 Oct 2026 11:56:25 +0900</pubDate>
    <category>River</category>
    <description>&lt;p&gt;The space between thoughts,
the gap between each breath.
Closer to death.
Yoso&lt;/p&gt;&lt;p&gt;From River.&lt;/p&gt;</description>
  </item>
  <item>
    <title>The bow</title>
    <link>https://river.yoso.one/#t112</link>
